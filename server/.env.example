# Port the API server listens on
PORT=3000

# Host to bind to. Defaults to 127.0.0.1 (localhost-only) if unset.
# Set to 0.0.0.0 ONLY if you understand the risk of exposing this beyond
# your own machine (see README security section) and pair it with
# REQUIRE_API_KEY below.
HOST=127.0.0.1

# Optional API key protection. Both must be set together, otherwise the
# server refuses requests.
REQUIRE_API_KEY=false
API_KEY=

# Where Baileys stores its multi-file auth session (login credentials).
# AUTH_DIR=.baileys-auth

# Where the SQLite message log / config database lives.
# DB_PATH=data.sqlite

# Timeout (ms) for each outgoing webhook delivery attempt.
WEBHOOK_TIMEOUT_MS=10000

# --- Rate gate (anti-ban throttling) ---------------------------------------
# Every /api/send/* request passes through this before reaching WhatsApp.
# See the "Rate gate" section in README.md for how each layer works.

# Randomized per-message delay range (ms). Never a fixed gap — a value is
# picked from this range on every send. Floored at 1000ms regardless of
# what you set here.
RATE_MIN_DELAY_MS=1500
RATE_MAX_DELAY_MS=4000

# Rolling send caps. Once hit, further sends are queued (not failed) until
# capacity frees up.
RATE_HOURLY_CAP=40
RATE_DAILY_CAP=200

# Separate, tighter daily cap for messaging numbers you've never exchanged
# a message with before — independent of overall cap headroom.
RATE_NEW_CONTACT_DAILY_CAP=25

# /api/send/bulk splits recipients into chunks of this size, with a longer
# randomized pause between chunks (on top of the per-message delay above).
RATE_BULK_CHUNK_SIZE=15
RATE_CHUNK_PAUSE_MIN_MS=30000
RATE_CHUNK_PAUSE_MAX_MS=90000

# Account warm-up curve: scales the daily cap up gradually based on days
# since your first successful connection, instead of allowing RATE_DAILY_CAP
# from day one. Format is "day:cap,day:cap,...". Set RATE_WARMUP_ENABLED=false
# to always use the flat RATE_DAILY_CAP instead.
RATE_WARMUP_ENABLED=true
RATE_WARMUP_SCHEDULE=1:50,4:100,8:200

# If sends fail this many times in a row, the queue pauses entirely for a
# bit (doubling each additional consecutive failure, capped), then resumes
# with widened delays for a while rather than snapping back to full speed.
RATE_ERROR_BACKOFF_THRESHOLD=3
RATE_ERROR_BACKOFF_BASE_MS=30000
RATE_ERROR_BACKOFF_MAX_MS=1800000

# How often the background worker retries queued (over-cap) sends.
RATE_QUEUE_WORKER_INTERVAL_MS=10000
